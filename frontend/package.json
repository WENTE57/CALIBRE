{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Calibre Desktop App",
  "author": "Calibre 25",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:exe": "npm run build && electron-builder --win && node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/win-unpacked/data', {recursive:true}); fs.copyFileSync('../backend/database.sqlite', 'dist-electron/win-unpacked/data/database.sqlite'); fs.copyFileSync('../backend/database.sqlite', 'dist-electron/win-unpacked/database.sqlite');\" && cd dist-electron && zip -rq \"Calibre_Desktop_Portable.zip\" win-unpacked && cd .."
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^2.15.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^9.0.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.calibre.app",
    "productName": "Calibre Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "../backend/database.sqlite",
        "to": "data/database.sqlite"
      },
      {
        "from": "../backend/database.sqlite",
        "to": "database.sqlite"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "public/Calibre25_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calibre 25"
    }
  }
}
